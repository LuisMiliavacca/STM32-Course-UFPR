void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart){
	if(huart->Instance == UART5){
		if(modo=='a'){
			flagA=1;
			flagB=0;
			flagC=0;
			flagD=0;
			TIM2 -> CCR1 = 0;
			TIM2 -> CCR2 = 0;
			TIM2 -> CCR4 = 0;
		}
		if(modo=='b'){
			flagA=0;
			flagB=1;
			flagC=0;
			flagD=0;
			GPIOB -> ODR &= 0x0011;
			TIM2 -> CCR1 = 0;
			TIM2 -> CCR2 = 0;
			TIM2 -> CCR4 = 0;
			GPIOC -> ODR |= 0x00FF;
		}
		if(modo=='c'){
			flagA=0;
			flagB=0;
			flagC=1;
			flagD=0;
			OLED_Test();
		}
		if(modo=='d'){
			flagA=0;
			flagB=0;
			flagC=0;
			flagD=1;
			TIM2 -> CCR1 = 0;
			TIM2 -> CCR2 = 0;
			TIM2 -> CCR4 = 0;
			GPIOC -> ODR &= 0xF0FF;
		}
		HAL_UART_Receive_IT(&huart5, &modo, 1);
	}
}
