  HAL_TIM_Base_Start_IT(&htim4);
  HAL_TIM_Base_Start_IT(&htim8);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_4);
  HAL_UART_Receive_IT(&huart5, &modo, 1);
  GPIOB -> PUPDR |= (0x00000110);
  while (1)
  {
	  if(flagOLED){
		  OLED_Test();
		  flagOLED=0;
	  }
	  if(flagA){
		  GPIOC->ODR |= 0x00FF;
		  sprintf(cont7seg_OLED,"cont=%d",contador7seg);
	  }
	  if(flagB){
		  sprintf(N_OLED,"pos=%d",N);
		  GPIOC -> ODR &= 0xF0FF;
		  GPIOC -> ODR |= (0x0100);
	  }
	  if(flagC){
		  if(flag_conf){
			  if(i_config>=150)
			  {
				  while((GPIOB -> IDR & 0x0004)==0){
				  }
			  }

			  if(flag_red){
			  	  TIM2 -> CCR1 = valorPWM; //escreve o valor do PWM em CCR1
		  	  }
		  	  if(flag_green){
			  	  TIM2 -> CCR2 = valorPWM; //escreve o valor do PWM em CCR1
		  	  }
		  	  if(flag_blue){
			  	  TIM2 -> CCR4 = valorPWM; //escreve o valor do PWM em CCR1
		  	  }
		  	  if((GPIOB -> IDR & 0x0004)==0){ //caso o botão seja apertado novamente, ele zera a flag
		  		  flag_conf=0;
		  	  }
		  	sprintf(valorPWM_OLED,"duty=%d",valorPWM);
		  }
	  }
	  if(flagD){
		  sprintf(eixoY_OLED,"X=%d",eixoX);
		  sprintf(eixoX_OLED,"Y=%d",eixoY);

	  }
	  if(flagBT){
			if(flagA){
				HAL_UART_Transmit(&huart5, cont7seg_OLED, strlen(cont7seg_OLED), 10);
			}
			if(flagB){
				HAL_UART_Transmit(&huart5, N_OLED, strlen(N_OLED), 10);
			}
			if(flagC){
				HAL_UART_Transmit(&huart5, valorPWM_OLED, strlen(valorPWM_OLED), 10);
			}
			if(flagD){
				HAL_UART_Transmit(&huart5, eixoX_OLED, strlen(eixoX_OLED), 10);
				HAL_UART_Transmit(&huart5, " ", 1, 10);
				HAL_UART_Transmit(&huart5, eixoY_OLED, strlen(eixoY_OLED), 10);
			}
		}
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
